<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:padding="12dp">

    <!-- Mínima y máxima apiladas en la esquina superior derecha -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MIN"
            android:textColor="@color/gray_light"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/txtMinValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="65"
            android:textColor="@color/blue"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="MAX"
            android:textColor="@color/gray_light"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/txtMaxValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="145"
            android:textColor="@color/red"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Frecuencia actual en el centro (elemento principal) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\u2665"
            android:textColor="@color/red"
            android:textSize="30sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <TextView
                android:id="@+id/txtCurrent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="78"
                android:textColor="@color/white"
                android:textSize="66sp"
                android:textStyle="bold" />

            <!-- Máxima en pequeño a un lado de la actual, separada por "/" -->
            <TextView
                android:id="@+id/txtMaxInline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="12dp"
                android:text="/ 145 BPM"
                android:textColor="@color/gray_light"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Indicador visual: ubica la frecuencia actual entre mínima y máxima -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/progressHeart"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:progressTint="@color/red"
            android:progress="16"
            android:max="80" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:text="Frecuencia cardiaca"
            android:textColor="@color/gray_light"
            android:textSize="12sp" />
    </LinearLayout>

</RelativeLayout>
