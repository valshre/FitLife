<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:padding="12dp">

    <TextView
        android:id="@+id/txtGoalHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:text="@string/goal_title"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Comparativa meta vs pasos actuales en el centro con anillo de progreso -->
    <FrameLayout
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_centerInParent="true">

        <com.example.fitlife.widgets.CircleProgressView
            android:id="@+id/ringGoal"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Pasos actuales ocupan la mayor cantidad de espacio -->
            <TextView
                android:id="@+id/txtCurrentSteps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6248"
                android:textColor="@color/pink"
                android:textSize="48sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtGoalSteps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="/ 8000"
                android:textColor="@color/gray_light"
                android:textSize="18sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Porcentaje completado en la parte inferior -->
    <TextView
        android:id="@+id/txtPercent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:text="78%"
        android:textColor="@color/green"
        android:textSize="30sp"
        android:textStyle="bold" />

</RelativeLayout>
