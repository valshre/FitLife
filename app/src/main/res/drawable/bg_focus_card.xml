<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo con señal de foco clara para navegación con control remoto (Smart TV) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pink_light" />
            <corners android:radius="16dp" />
            <stroke android:width="4dp" android:color="@color/pink" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pink_light" />
            <corners android:radius="16dp" />
            <stroke android:width="4dp" android:color="@color/pink" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#EEEEEE" />
        </shape>
    </item>
</selector>
